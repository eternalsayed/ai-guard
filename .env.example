# Copy to .env and fill in before running `node build.js` locally.
# On Netlify: set this in Site settings → Environment variables.

# Full URL of your deployed site — no trailing slash.
# Can be a custom domain or the default Netlify subdomain.
HOSTED_URL=https://aisentry.netlify.app

# Google Analytics 4 measurement ID — optional. Leave blank to disable GA.
# Get this from GA → Admin → Data streams → your stream → Measurement ID (G-XXXXXXX)
GTAG_ID=
